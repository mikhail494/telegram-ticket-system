{
  "name": "telegram-support-ticket-bot",
  "version": "1.3.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "Production-ready Telegram support ticket bot built with Node.js, TypeScript, grammY, and SQLite.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "setup": "tsx src/setup.ts",
    "owner:recover": "tsx src/ownerRecovery.ts",
    "owner:pair": "tsx src/ownerPair.ts",
    "db:backup": "tsx src/dbBackup.ts",
    "db:restore:verify": "tsx src/dbRestoreVerify.ts",
    "test": "node scripts/run-tests.mjs",
    "test:coverage": "c8 --reporter=text --reporter=json node scripts/run-tests.mjs",
    "test:typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src test scripts --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "better-sqlite3": "^11.9.1",
    "dotenv": "^16.4.7",
    "fflate": "^0.8.3",
    "franc-min": "^6.2.0",
    "grammy": "^1.45.1",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.17.16",
    "c8": "^12.0.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.67.0"
  }
}
