BOT_TOKEN=
# Optional legacy migration input. New installations select a group in Telegram.
STAFF_CHAT_ID=
DATABASE_URL=file:./data/support.db
LOG_LEVEL=info
BACKUP_ENABLED=true
# Defaults to a backups directory beside the SQLite database.
BACKUP_DIR=
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_COUNT=14
# Native/PM2 operational HTTP is disabled unless explicitly enabled.
OPS_HTTP_ENABLED=false
OPS_HTTP_HOST=127.0.0.1
OPS_HTTP_PORT=3000
